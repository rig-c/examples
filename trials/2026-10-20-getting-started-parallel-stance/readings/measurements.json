  "r": "split feet, right leg turned rigidly about the hip, knee straight",
  "f": "series a plus foot_r turned 44.4 deg x step",
  "g": "series r plus foot_r turned 44.4 deg x step",
  "h": "series r plus skirt_r0 keyed equal to leg_r0",
  "j": "series a plus skirt_r0 keyed equal to leg_r0",
  "k": "series j plus skirt_c0 at 1/2 of leg_r0",
  "i": "series j plus skirt_c0 at 1/4 of leg_r0",
  "cloth idle/cbeat/dbeat/ebeat": "cloth rig, 2.5 s beat at 75% of the way, hip x 0 / -6 / -12, skirt unkeyed, physics on, 24 fps",
  "cloth cfol/dfol/efol": "as cbeat/dbeat/ebeat with skirt0_0 keyed equal to leg_r0",
  "cloth ufol/pfol/pbeat": "50% of the way: hip still + skirt0_0 follows / hip -6 + skirt0_0 follows / hip -6 unkeyed skirt",
  "settle (cloth)": "settle-cloth.anim.json built by rig-parts build on the cloth recipe, 24 fps, physics on",
